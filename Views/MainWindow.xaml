<Window x:Class="AppSoftConsola.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AppSoftConsola.ViewModels"
        Title="InnovaStyl POS"
        Icon="pack://application:,,,/Assets/ISLOGO.ico"
        Height="900" Width="1500"
        Background="#0F172A"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- ⭐ CONTENEDOR PRINCIPAL -->
    <DockPanel>

        <!-- ⭐ TU INTERFAZ ACTUAL DEL POS -->
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: PRODUCTOS -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="15" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- título -->
                        <RowDefinition Height="*"/>
                        <!-- productos -->
                        <RowDefinition Height="Auto"/>
                        <!-- botones -->
                    </Grid.RowDefinitions>

                    <TextBlock Text="LISTADO DE PRODUCTOS"
                               Foreground="#3BA9F5"
                               FontSize="18" FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <!-- ⭐ LISTADO DE PRODUCTOS EN BOTONES -->
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Productos}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.AgregarProductoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            FontSize="25"
                                            Padding="20"
                                            Margin="10"
                                            Background="#38BDF8"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand">

                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Description}" FontSize="25" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Amount, StringFormat='${0:N2}'}" FontSize="22" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- ⭐ BOTONES DE ADMINISTRACIÓN + ROLE A LA DERECHA -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ⭐ BOTONES A LA IZQUIERDA -->
                        <StackPanel Orientation="Horizontal"
                Grid.Column="0"
                HorizontalAlignment="Left">

                            <Button x:Name="btnProductos"
                Content="PRODUCTOS"
                Width="150" Height="40"
                Margin="0,0,10,0"
                Background="#3BA9F5"
                Foreground="White"
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                Click="OpenCrudProductos"/>

                            <Button x:Name="btnParametros"
                Content="PARÁMETROS"
                Width="150" Height="40"
                Margin="0,0,10,0"
                Background="#0284C7"
                Foreground="White"
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                Click="OpenParametros"/>

                            <Button x:Name="btnAdmin"
                Content="ADMIN"
                Width="150" Height="40"
                Background="#64748B"
                Foreground="White"
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                Click="OpenAdminLogin"/>
                        </StackPanel>

                        <!-- ⭐ ROLE A LA DERECHA -->
                        <TextBlock x:Name="txtRoleDisplay"
               Grid.Column="1"
               FontSize="18"
               FontWeight="Bold"
               Foreground="#2563EB"
               HorizontalAlignment="Right"
               VerticalAlignment="Center"
               Margin="0,0,20,0"/>
                    </Grid>

                </Grid>
            </Border>

            <!-- PANEL DERECHO: TICKET -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="TICKET A IMPRIMIR"
                               Foreground="White"
                               FontSize="26"
                               HorizontalAlignment="Left"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Ticket N°:"
                                   Foreground="White" FontSize="14" Margin="0,0,10,0"
                                   HorizontalAlignment="Right"
                                   Grid.Column="0"/>

                        <StackPanel Orientation="Horizontal" Grid.Column="1">
                            <TextBlock Text="{Binding PtoVtaFormatted}"
                                       Foreground="#3BA9F5" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="-"
                                       Foreground="White" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding TicketNroFormatted}"
                                       Foreground="#3BA9F5" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Carrito}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Product.Description}"
                                                   Foreground="White"
                                                   FontSize="20"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Quantity, StringFormat='x{0}'}"
                                                   Foreground="#3BA9F5"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SubTotal, StringFormat='${0:N2}'}"
                                                   Foreground="White"
                                                   FontSize="20"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="3"
                                                Content="X"
                                                Command="{Binding DataContext.QuitarProductoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="#EF4444"
                                                Foreground="White"
                                                Width="32"
                                                Height="32"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                FontWeight="Bold"
                                                VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="16">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,10">
                        <TextBlock Text="Art.:"
                                   Foreground="White" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding ItemsCount}"
                                   Foreground="#3BA9F5" FontSize="14" Margin="0,0,20,0"/>
                        <TextBlock Text="A Pagar:"
                                   Foreground="White" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Total, StringFormat='${0:N2}'}"
                                   Foreground="#4ADE80" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="4" Columns="3" Margin="0,0,0,10">
                        <Button Content="EFECTIVO"
                                Command="{Binding ProcesarPagoCommand}"
                                CommandParameter="EF"
                                Height="45" Margin="2"
                                Background="#3BA9F5" Foreground="White" FontWeight="Bold"
                                BorderThickness="0"/>

                        <Button Content="VIRTUAL"
                                Command="{Binding ProcesarPagoCommand}"
                                CommandParameter="MP"
                                Height="45" Margin="2"
                                Background="#0284C7" Foreground="White" FontWeight="Bold"
                                BorderThickness="0"/>

                        <Button Content="BORRAR TICKET"
                                Command="{Binding LimpiarTicketCommand}"
                                Height="45" Margin="2"
                                Background="#EF4444" Foreground="White" FontWeight="Bold"
                                BorderThickness="0"/>
                    </UniformGrid>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="VENDIDO"
                                Command="{Binding ShowCashCommand}"
                                Height="35" Margin="0,0,10,0"
                                Background="#64748B" Foreground="White"
                                BorderThickness="0"/>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Left">

                                <TextBlock Text="EF:"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,0,10,0"/>

                                <TextBlock Text="{Binding CajaEF, StringFormat='${0:N2}'}"
                                           Foreground="#4ADE80"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="0,0,50,0"/>

                                <TextBlock Text="Electrónico:"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,0,10,0"/>

                                <TextBlock Text="{Binding CajaMP, StringFormat='${0:N2}'}"
                                           Foreground="#4ADE80"
                                           FontSize="16"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>

    </DockPanel>

</Window>
