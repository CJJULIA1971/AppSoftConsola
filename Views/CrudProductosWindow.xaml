<Window x:Class="AppSoftConsola.Views.CrudProductosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AppSoftConsola.Views"
        Title="Administrar Productos"
        Height="600" Width="1200"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <local:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================
             LISTA DE PRODUCTOS (IZQUIERDA)
             ============================ -->
        <Border Background="White"
                CornerRadius="12"
                Padding="20"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,16,0"
                Effect="{DynamicResource ShadowEffect}">

            <StackPanel>

                <TextBlock Text="PRODUCTOS"
                           Foreground="#1F2937"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- Buscador -->
                <Grid Margin="0,0,0,16">
                    <Border Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBox x:Name="txtBuscar"
                                 Height="36"
                                 Padding="8"
                                 Background="Transparent"
                                 Foreground="#374151"
                                 BorderThickness="0"
                                 TextChanged="txtBuscar_TextChanged"/>
                    </Border>

                    <TextBlock Text="Buscar descripción..."
                               Foreground="#9CA3AF"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=txtBuscar,
                                            Converter={StaticResource EmptyToVisibilityConverter}}"/>
                </Grid>

                <!-- Encabezados -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Código" Grid.Column="0"
                               FontSize="14" Foreground="#2563EB" FontWeight="Bold"/>

                    <TextBlock Text="Descripción" Grid.Column="1"
                               FontSize="14" Foreground="#2563EB" FontWeight="Bold"/>

                    <TextBlock Text="Precio" Grid.Column="2"
                               FontSize="14" Foreground="#2563EB" FontWeight="Bold"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="Orden" Grid.Column="3"
                               FontSize="14" Foreground="#2563EB" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Grid>

                <!-- Lista -->
                <ListBox x:Name="lstProductos"
                         Background="White"
                         Foreground="#374151"
                         BorderThickness="0"
                         Height="450"
                         SelectionChanged="lstProductos_SelectionChanged">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,0,1"
                                                Padding="8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F3F4F6"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#DBEAFE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Code}" Grid.Column="0"
                                           Foreground="#2563EB" FontSize="16"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding Description}" Grid.Column="1"
                                           Foreground="#374151" FontSize="16"/>

                                <TextBlock Text="{Binding Amount, StringFormat='${0:N2}'}"
                                           Grid.Column="2" Foreground="#059669"
                                           FontSize="16" HorizontalAlignment="Right"/>

                                <TextBlock Text="{Binding OrderShow}" Grid.Column="3"
                                           Foreground="#6B7280" FontSize="16"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </StackPanel>
        </Border>

        <!-- ============================
             CRUD (DERECHA)
             ============================ -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="12"
                Padding="20"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Effect="{DynamicResource ShadowEffect}">

            <StackPanel>

                <TextBlock Text="DETALLES"
                           Foreground="#1F2937"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- Caja de detalles -->
                <StackPanel>

                    <!-- Código -->
                    <TextBlock Text="Código" Foreground="#2563EB" FontWeight="Bold" FontSize="14"/>
                    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Margin="0,4,0,12">
                        <TextBox x:Name="txtCode"
                                 Height="36"
                                 Padding="8"
                                 FontSize="16"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#2563EB"
                                 PreviewTextInput="NumericInteger_PreviewTextInput"
                                 DataObject.Pasting="IntegerPasting"/>
                    </Border>

                    <!-- Descripción -->
                    <TextBlock Text="Descripción" Foreground="#2563EB" FontWeight="Bold" FontSize="14"/>
                    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Margin="0,4,0,12">
                        <TextBox x:Name="txtDesc"
                                 Height="36"
                                 Padding="8"
                                 FontSize="16"
                                 Background="Transparent"
                                 BorderThickness="0"/>
                    </Border>

                    <!-- Precio -->
                    <TextBlock Text="Precio" Foreground="#2563EB" FontWeight="Bold" FontSize="14"/>
                    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Margin="0,4,0,12">
                        <TextBox x:Name="txtAmount"
                                 Height="36"
                                 Padding="8"
                                 FontSize="16"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#059669"
                                 HorizontalContentAlignment="Right"
                                 PreviewTextInput="NumericDecimal_PreviewTextInput"
                                 DataObject.Pasting="DecimalPasting"/>
                    </Border>

                    <!-- Orden -->
                    <TextBlock Text="Orden" Foreground="#2563EB" FontWeight="Bold" FontSize="14"/>
                    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Margin="0,4,0,20">
                        <TextBox x:Name="txtOrder"
                                 Height="36"
                                 Padding="8"
                                 FontSize="16"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#6B7280"
                                 PreviewTextInput="NumericInteger_PreviewTextInput"
                                 DataObject.Pasting="IntegerPasting"/>
                    </Border>

                </StackPanel>

                <!-- Botones -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Agregar" Width="100" Margin="0,0,10,0"
                            Background="#2563EB" Foreground="White"
                            BorderThickness="0" Height="36"
                            Click="Agregar_Click"/>

                    <Button Content="Guardar" Width="100" Margin="0,0,10,0"
                            Background="#059669" Foreground="White"
                            BorderThickness="0" Height="36"
                            Click="Guardar_Click"/>

                    <Button Content="Eliminar" Width="100"
                            Background="#DC2626" Foreground="White"
                            BorderThickness="0" Height="36"
                            Click="Eliminar_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>

</Window>
