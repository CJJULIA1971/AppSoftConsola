<Window x:Class="AppSoftConsola.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar Sesión"
        Height="450" Width="500"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Border Background="White"
            CornerRadius="12"
            Padding="30"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            Margin="20">

        <StackPanel>

            <!-- Título -->
            <TextBlock Text="INICIAR SESIÓN"
                       Foreground="#1F2937"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,25"
                       HorizontalAlignment="Center"/>

            <!-- Usuario -->
            <TextBlock Text="Usuario"
                       Foreground="#2563EB"
                       FontWeight="Bold"
                       FontSize="14"/>
            <Border Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,4,0,16">
                <TextBox x:Name="txtUserId"
                         Height="40"
                         Padding="10"
                         FontSize="16"
                         Background="Transparent"
                         BorderThickness="0"/>
            </Border>

            <!-- Password -->
            <TextBlock Text="Password"
                       Foreground="#2563EB"
                       FontWeight="Bold"
                       FontSize="14"/>
            <Border Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,4,0,25">
                <PasswordBox x:Name="txtPassword"
                             Height="40"
                             Padding="10"
                             FontSize="16"
                             Background="Transparent"
                             BorderThickness="0"/>
            </Border>

            <!-- Botón Ingresar -->
            <Button Content="Ingresar"
                    Height="42"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Ingresar_Click"/>

        </StackPanel>

    </Border>

</Window>
